{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FidoParole",
  "mainBinaryName": "fidoparole",
  "version": "0.1.0",
  "identifier": "com.token2.fidoparole",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FidoParole",
        "width": 1040,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "linux": { "deb": { "depends": ["libssl3", "libcbor0.10", "libudev1"] } }
  }
}
